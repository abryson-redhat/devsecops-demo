                                "secretRef": {
                                    "name": "argocd-env-secret"
                                }
                            }
                        ]
                    },
                    "steps": [
                        {
                            "image": "quay.io/rcarrata/argocd:$(params.argocd-version)",
                            "name": "login-sync-wait",
                            "script": "if [ -z $ARGOCD_AUTH_TOKEN ]; then\n  yes | argocd login $ARGOCD_SERVER --username=$ARGOCD_USERNAME --password=$ARGOCD_PASSWORD ;\nfi\n\nargocd app sync $(params.application-name) --revision $(params.revision) $(params.flags) && sleep 3\n\nargocd app wait $(params.application-name) --health $(params.flags)\n"

gs\n  name: gogs\n  namespace: cicd\nspec:\n  ports:\n  - name: 3000-tcp\n    port: 3000\n    protocol: TCP\n    targetPort: 3000\n  selector:\n    app: gogs\n    name: gogs\n  type: ClusterIP\n---\nkind: Route\napiVersion: route.openshift.io/v1\nid: gogs-http\nmetadata:\n  labels:\n    app: gogs\n  name: gogs\n  namespace: cicd\nspec:\n  to:\n    name: gogs\n---\nkind: PersistentVolumeClaim\napiVersion: v1\nmetadata:\n  name: gogs-data\n  namespace: cicd\n  labels:\n    app: gogs\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n---\nkind: PersistentVolumeClaim\napiVersion: v1\nmetadata:\n  name: gogs-postgres-data\n  namespace: cicd\n  labels:\n    app: gogs\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 1Gi\n",
